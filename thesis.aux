\newlabel{fig:illust}{{5.1}{30}{\footnotesize (a)\PORF {} is violated (b)\WCoh {} is violated: $\wt _1(x)~\hb ~\wt _2(x)$ while $\wt _2(x)~\mo ~\wt _1(x)$, (c)\RCoh {} is violated: $\wt _1(x)~\rf ~\rd (x)$ with $\wt _1(x)~\mo ~\wt _2(x)$ and $\wt _2(x)~\hb ~\rd (x)$, (d)\WRCoh {} is violated: $\wt _1(x)~\rf ~\rd (x)$ with $\wt _1(x)~\hb ~\wt _2(x)$ and $\wt _2(x)~\hb ~\rd (x)$, (e)\SWCoh {} is violated : $\hb \cup \mo $ cycle, (f)\RlxRCoh {} is violated: $\wt _1(x)~\mo ~\wt _2(x)$, $\rd _2(x)~\po ~\rd _1(x)$ with $\wt _2(x)~\rf ~\rd _2(x)$ and $\wt _1(x)~\rf ~\rd _1(x)$, (g)\RlxWCoh {} is violated\relax }{figure.caption.33}{}}
